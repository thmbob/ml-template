{
    "name": "ML Template (Universal)",
    "build": {
        "context": "..",
        "dockerfile": "docker/Dockerfile",
        "args": {
            "ACCEL": "cpu"
        }
    },
    "forwardPorts": [
        8888,
        6006
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/env/bin/python",
                "python.terminal.activateEnvironment": true,
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "python.analysis.typeCheckingMode": "strict",
                "mypy.dmypyExecutable": "/opt/conda/env/bin/dmypy"
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff",
                "matangover.mypy",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": "pre-commit install"
}
